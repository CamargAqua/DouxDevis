ANTHROPIC_API_KEY=sk-ant-...
YOUSIGN_API_KEY=your-yousign-api-key-here

# --- Devisly (monté sous /devisly, cf. devisly/app.py) ---
# Postgres partagé avec le projet Devisly (même DB que Devisly/demo/.env en local).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devisly
# Tenant réutilisé sous /devisly (déjà seedé côté Devisly : logo, coefficients).
PRIMARY_TENANT_SLUG=doux
# Cookie distinct de celui de DouxDevis pour ne pas s'écraser (même domaine, 2 apps).
SESSION_COOKIE_NAME=devisly_session
SESSION_COOKIE_PATH=/devisly
# Affiche le lien "Retour à Doux Devis" côté Devisly (absent en déploiement standalone).
SHOW_DOUXDEVIS_TOGGLE=1
# Panneau /superadmin de Devisly (optionnel en local).
SUPERADMIN_PASSWORD=
